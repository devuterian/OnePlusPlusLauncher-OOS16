<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    tools:context=".ui.activity.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:menu="@menu/main_top_menu"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/TextAppearance.App.TitleLarge" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fadingEdgeLength="12dp"
        android:paddingBottom="24dp"
        android:requiresFadingEdge="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/status_card"
                style="@style/Widget.App.StatusCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/m3_status_inactive">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/main_img_status"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_warn"
                        app:tint="@color/m3_on_status" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/main_text_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/module_not_activated"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                            android:textColor="@color/m3_on_status" />

                        <TextView
                            android:id="@+id/main_text_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.92"
                            android:text="@string/module_version"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/m3_on_status" />

                        <TextView
                            android:id="@+id/main_text_version2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="0.92"
                            android:text="@string/supported_launcher_version"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/m3_on_status" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/restart_launcher_button"
                            style="@style/Widget.App.Button.Restart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/restart_launcher_button"
                            app:icon="@android:drawable/ic_menu_rotate"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/feature_settings"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/language_input_layout"
                        style="@style/Widget.App.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="@string/pref_language_title">

                        <AutoCompleteTextView
                            android:id="@+id/language_dropdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textAppearance="@style/TextAppearance.App.BodyLarge" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/fuzzy_search_switch_new"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/pref_fuzzy_search_title" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/enter_key_launch_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_enter_key_launch_title" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/category_auto_focus"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/auto_focus_search_swipe_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/pref_auto_focus_search_swipe_title" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/category_search_redirect"
                        android:textAppearance="@style/TextAppearance.App.LabelSmall" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/global_search_redirect_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/pref_global_search_redirect_title" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/auto_focus_search_redirect_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_auto_focus_search_redirect_title" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/swipe_down_search_redirect_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_swipe_down_search_redirect_title" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/auto_focus_swipe_down_redirect_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_auto_focus_swipe_down_redirect_title" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/left_swipe_discover_redirect_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_left_swipe_discover_redirect_title" />

                    <com.wizpizz.onepluspluslauncher.ui.view.MaterialSwitch
                        android:id="@+id/auto_focus_left_swipe_redirect_switch"
                        style="@style/Widget.App.Switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_auto_focus_left_swipe_redirect_title" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@mipmap/ic_yukihookapi" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:autoLink="web"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/about_module"
                        android:textAppearance="@style/TextAppearance.App.BodyMedium" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
